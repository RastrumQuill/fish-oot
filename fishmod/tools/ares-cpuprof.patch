+// fish-oot: ARES_CPUPROF=<file>: the CPU on the interpreter, every instruction counted by PC (KSEG0 code) with its
+// clocks and the data cache lines it filled and wrote back; the file rewritten every 2^25 instructions as records of
+// (u32 pc, u32 instructions, u64 clocks, u32 fills, u32 writebacks, u32 instruction cache fills), host byte order; and <file>.lines, the fills by
+// the line filled, those from code in ARES_CPUPROF_LO..ARES_CPUPROF_HI (hex) apart
+static const char* cpuProfPath = getenv("ARES_CPUPROF");
+struct CpuProfEntry { u32 instructions; u32 fills; u32 writebacks; u32 ifills; u64 clocks; };
+static CpuProfEntry* cpuProf = nullptr;
+u32 cpuProfFills = 0, cpuProfWritebacks = 0;
+u32* cpuProfLines = nullptr;
+u32 cpuProfLo = 0, cpuProfHi = 0;
+static u64 cpuProfTotal = 0;
+static auto cpuProfWrite() -> void {
+  string tmp{cpuProfPath, ".tmp"};
+  if(auto fp = fopen(tmp, "wb")) {
+    for(u32 n : range(0x200000)) {
+      auto& e = cpuProf[n];
+      if(!e.instructions) continue;
+      u32 head[2] = {0x80000000u + (n << 2), e.instructions};
+      u32 tail[3] = {e.fills, e.writebacks, e.ifills};
+      fwrite(head, 4, 2, fp); fwrite(&e.clocks, 8, 1, fp); fwrite(tail, 4, 3, fp);
+    }
+    fclose(fp);
+    rename(tmp, cpuProfPath);
+  }
+  //<file>.lines: the fills by line: records of (u32 address, u32 fills from the code range, u32 all fills)
+  string ltmp{cpuProfPath, ".lines.tmp"};
+  if(auto fp = fopen(ltmp, "wb")) {
+    for(u32 n : range(0x80000)) {
+      if(!cpuProfLines[n * 2 + 1]) continue;
+      u32 rec[3] = {0x80000000u + (n << 4), cpuProfLines[n * 2], cpuProfLines[n * 2 + 1]};
+      fwrite(rec, 4, 3, fp);
+    }
+    fclose(fp);
+    rename(ltmp, string{cpuProfPath, ".lines"});
+  }
+}
+
 auto CPU::instruction() -> bool {
+  if(cpuProfPath) {
+    if(!cpuProf) {
+      cpuProf = (CpuProfEntry*)calloc(0x200000, sizeof(CpuProfEntry));
+      cpuProfLines = (u32*)calloc(0x80000 * 2, sizeof(u32));
+      if(auto lo = getenv("ARES_CPUPROF_LO")) cpuProfLo = strtoul(lo, nullptr, 16);
+      if(auto hi = getenv("ARES_CPUPROF_HI")) cpuProfHi = strtoul(hi, nullptr, 16);
+    }
+    u64 pc = ipu.pc; s64 clock = Thread::clock; u32 fills = cpuProfFills, writebacks = cpuProfWritebacks;
+    auto imisses = profile.icacheMisses;
+    bool result = instructionInner();
+    if((pc >> 23) == (0xffffffff80000000ull >> 23)) {
+      auto& e = cpuProf[(pc & 0x7fffff) >> 2];
+      e.instructions++; e.clocks += Thread::clock - clock;
+      e.fills += cpuProfFills - fills; e.writebacks += cpuProfWritebacks - writebacks;
+      e.ifills += profile.icacheMisses - imisses;
+    }
+    if((++cpuProfTotal & 0x1ffffff) == 0) cpuProfWrite();
+    return result;
+  }
+  return instructionInner();
+}
