+// fish-oot test hook: a minimal SummerCart64 (ARES_SC64_DIR: its USB writes are saved there, one file a packet)
+struct FishSc64 {
+  u8 buf[8192];
+  u32 data0 = 0, data1 = 0, scr = 0, key = 0, unlocked = 0, busyReads = 0, packets = 0;
+  static auto dir() -> const char* { static const char* d = getenv("ARES_SC64_DIR"); return d; }
+  auto command(u32 id) -> void {
+    scr = 0;
+    if(id == 'M') {
+      u32 addr = data0, len = data1 & 0xffffff;
+      if(addr >= 0x1ffe'0000 && len <= 8192) {
+        char name[512]; snprintf(name, sizeof(name), "%s/binaryout-%06u.bin", dir(), packets++);
+        if(FILE* f = fopen(name, "wb")) { fwrite(buf + (addr - 0x1ffe'0000), 1, len, f); fclose(f); }
+      } else scr = 1u << 30;
+      busyReads = 4; // (the USB "sending" for the next few status checks)
+    } else if(id == 'U') {
+      data0 = busyReads ? (1u << 31) : 0;
+      if(busyReads) busyReads--;
+    }
+  }
+  auto read(u32 address) -> u32 {
+    if(address >= 0x1ffe'0000 && address < 0x1ffe'2000) {
+      u32 o = address & 0x1ffe; return buf[o] << 8 | buf[o + 1];
+    }
+    switch(address & 0x1f) {
+    case 0x00: return scr; case 0x04: return data0; case 0x08: return data1;
+    case 0x0c: return unlocked ? 0x53437632 : 0;
+    }
+    return 0;
+  }
+  auto write(u32 address, u32 data, bool half) -> void {
+    if(address >= 0x1ffe'0000 && address < 0x1ffe'2000) {
+      u32 o = address & 0x1fff;
+      if(half) { o &= ~1; buf[o] = data >> 8; buf[o + 1] = data; }
+      else { o &= ~3; buf[o] = data >> 24; buf[o + 1] = data >> 16; buf[o + 2] = data >> 8; buf[o + 3] = data; }
+      return;
+    }
+    switch(address & 0x1f) {
+    case 0x00: command(data & 0xff); return;
+    case 0x04: data0 = data; return; case 0x08: data1 = data; return;
+    case 0x10: if(key == 0x5F554E4C && data == 0x4F434B5F) unlocked = 1; key = data; return;
+    }
+  }
+};
+inline FishSc64 fishSc64;
