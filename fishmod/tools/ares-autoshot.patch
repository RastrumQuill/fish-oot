+  // fish-oot: ARES_AUTOSHOT=<dir> saves every ARES_AUTOSHOT_EVERY-th frame (default 15) raw, for A/B captures
+  if(auto dir = getenv("ARES_AUTOSHOT")) {
+    static u32 autoshotFrame = 0;
+    u32 every = getenv("ARES_AUTOSHOT_EVERY") ? atoi(getenv("ARES_AUTOSHOT_EVERY")) : 15;
+    if((autoshotFrame++ % every) == 0) {
+      string name{dir, "/frame_", pad(autoshotFrame, 7, '0'), ".png"};
+      Encode::PNG::RGB8(name, data, pitch, width, height);
+    }
+  }
+  // fish-oot: ARES_FRAMEHASH=<file> appends a hash of every frame (FNV-1a over the pixels): two builds that should
+  // draw the same can be compared by their sequences of distinct frames, whatever their timing
+  if(auto path = getenv("ARES_FRAMEHASH")) {
+    static FILE* hashes = fopen(path, "w");
+    if(hashes) {
+      u64 h = 0xcbf29ce484222325ull;
+      for(u32 y = 0; y < height; y++) {
+        auto row = (const u8*)data + y * pitch;
+        for(u32 x = 0; x < width * 4; x++) h = (h ^ row[x]) * 0x100000001b3ull;
+      }
+      fprintf(hashes, "%ux%u %016llx\n", width, height, (unsigned long long)h);
+      fflush(hashes);
+    }
+  }
 
