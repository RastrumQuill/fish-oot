+// fish-oot: ARES_RSPPROF=<file>: the RSP on the interpreter, every instruction's clocks counted by task type
+// (kind 1: the microcode named by ARES_RSPPROF_KEY, 0: any other) and PC; the file rewritten every 2^22 instructions
+// as records of (u32 kind, u32 pc, u64 instructions, u64 clocks), host byte order
+static const char* rspProfPath = getenv("ARES_RSPPROF");
+static u64 rspProfCount[4][1024][2];
+static u64 rspProfTotal = 0;
+static auto rspProfWrite() -> void {
+  string tmp{rspProfPath, ".tmp"};
+  if(auto fp = fopen(tmp, "wb")) {
+    for(u32 t : range(4)) for(u32 pc : range(1024)) {
+      if(!rspProfCount[t][pc][0]) continue;
+      u32 head[2] = {t, pc << 2};
+      fwrite(head, 4, 2, fp);
+      fwrite(rspProfCount[t][pc], 8, 2, fp);
+    }
+    fclose(fp);
+    rename(tmp, rspProfPath);
+  }
+}
+
 auto RSP::instruction() -> void {
-  if(Accuracy::RSP::Recompiler && recompiler.enabled) {
+  u32 profPc = ipu.pc & 0xffc;
+  if(Accuracy::RSP::Recompiler && recompiler.enabled && !rspProfPath) {
     auto block = recompiler.block(ipu.pc);
     block->execute(*this);
   } else {
@@ -80,6 +101,14 @@ auto RSP::instruction() -> void {
   //with the recompiler, it only steps for taken branch stalls
   step(pipeline.clocks);
   pipeline.clocksTotal += pipeline.clocks;
+  if(rspProfPath) {
+    //kind 1: the microcode whose first instruction (IMEM 0x80, after the boot code) is ARES_RSPPROF_KEY (hex); 0: any other
+    static u32 wanted = getenv("ARES_RSPPROF_KEY") ? strtoul(getenv("ARES_RSPPROF_KEY"), nullptr, 16) : 0;
+    u32 type = imem.read<Word>(0x80) == wanted;
+    rspProfCount[type][profPc >> 2][0] += 1 + pipeline.dblIssueCount;
+    rspProfCount[type][profPc >> 2][1] += pipeline.clocks;
+    if((++rspProfTotal & 0x3fffff) == 0) rspProfWrite();
+  }
 }
 
