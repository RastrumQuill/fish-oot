+// fish-oot: ARES_CPUPROF=<file>: the CPU on the interpreter, every instruction counted by PC (KSEG0 code) with its
+// clocks and the data cache lines it filled and wrote back; the file rewritten every 2^25 instructions as records of
+// (u32 pc, u32 instructions, u64 clocks, u32 fills, u32 writebacks, u32 instruction cache fills), host byte order; and <file>.lines, the fills by
+// the line filled, those from code in ARES_CPUPROF_LO..ARES_CPUPROF_HI (hex) apart
+static const char* cpuProfPath = getenv("ARES_CPUPROF");
+struct CpuProfEntry { u32 instructions; u32 fills; u32 writebacks; u32 ifills; u64 clocks; };
+static CpuProfEntry* cpuProf = nullptr;
+u32 cpuProfFills = 0, cpuProfWritebacks = 0;
+u32* cpuProfLines = nullptr;
+u32* cpuProfBytes = nullptr;
+u32 cpuProfLo = 0, cpuProfHi = 0;
+static u64 cpuProfTotal = 0;
+static auto cpuProfWrite() -> void {
+  string tmp{cpuProfPath, ".tmp"};
+  if(auto fp = fopen(tmp, "wb")) {
+    for(u32 n : range(0x200000)) {
+      auto& e = cpuProf[n];
+      if(!e.instructions) continue;
+      u32 head[2] = {0x80000000u + (n << 2), e.instructions};
+      u32 tail[3] = {e.fills, e.writebacks, e.ifills};
+      fwrite(head, 4, 2, fp); fwrite(&e.clocks, 8, 1, fp); fwrite(tail, 4, 3, fp);
+    }
+    fclose(fp);
+    rename(tmp, cpuProfPath);
+  }
+  //<file>.lines: the fills by line: records of (u32 address, u32 fills from the code range, u32 all fills)
+  string ltmp{cpuProfPath, ".lines.tmp"};
+  if(auto fp = fopen(ltmp, "wb")) {
+    for(u32 n : range(0x80000)) {
+      if(!cpuProfLines[n * 2 + 1]) continue;
+      u32 rec[3] = {0x80000000u + (n << 4), cpuProfLines[n * 2], cpuProfLines[n * 2 + 1]};
+      fwrite(rec, 4, 3, fp);
+    }
+    fclose(fp);
+    rename(ltmp, string{cpuProfPath, ".lines"});
+  }
+  //<file>.bytes: every byte the code range read or wrote through the cache: records of (u32 address, u32 reads, u32 writes)
+  string btmp{cpuProfPath, ".bytes.tmp"};
+  if(cpuProfBytes) if(auto fp = fopen(btmp, "wb")) {
+    for(u32 n : range(0x800000)) {
+      if(!cpuProfBytes[n * 2] && !cpuProfBytes[n * 2 + 1]) continue;
+      u32 rec[3] = {0x80000000u + n, cpuProfBytes[n * 2], cpuProfBytes[n * 2 + 1]};
+      fwrite(rec, 4, 3, fp);
+    }
+    fclose(fp);
+    rename(btmp, string{cpuProfPath, ".bytes"});
+  }
+}
+
+static const char* busProfPath = getenv("ARES_BUSPROF");
+static u32 busProfLo = 0, busProfHi = 0;
+static u64 busProfTicks = 0;
+static auto busProfWrite() -> void {
+  static const char* names[14] = {"unknown", "cpu_code", "cpu_data", "cpu_uncached", "sp_other", "pi", "si", "vi", "ai",
+                                  "dp_lists", "dp_draw", "cpu_code_audio", "cpu_data_audio", "sp_audio"};
+  string tmp{busProfPath, ".tmp"};
+  if(auto fp = fopen(tmp, "w")) {
+    fprintf(fp, "# class read_bytes read_count write_bytes write_count\n");
+    for(u32 n : range(14)) fprintf(fp, "%s %llu %llu %llu %llu\n", names[n], (unsigned long long)busProf.bytes[n][0],
+      (unsigned long long)busProf.count[n][0], (unsigned long long)busProf.bytes[n][1], (unsigned long long)busProf.count[n][1]);
+    fprintf(fp, "sp_other_dmas %llu 0 %llu 0\nsp_audio_dmas %llu 0 %llu 0\n", (unsigned long long)busProf.dmas[0][0],
+      (unsigned long long)busProf.dmas[0][1], (unsigned long long)busProf.dmas[1][0], (unsigned long long)busProf.dmas[1][1]);
+    for(u32 out : range(2)) for(u32 im : range(2)) for(u32 a : range(512)) {
+      auto& e = busProf.audioDma[out][im][a];
+      if(e[0]) fprintf(fp, "audio_dma %s %s 0x%03x %u %u\n", out ? "out" : "in", im ? "imem" : "dmem", a << 3, e[0], e[1]);
+    }
+    fclose(fp);
+    rename(tmp, busProfPath);
+  }
+}
+
 auto CPU::instruction() -> bool {
+  if(busProfPath) {
+    if(!busProf.on) {
+      busProf.on = true;
+      if(auto lo = getenv("ARES_BUSPROF_LO")) busProfLo = strtoul(lo, nullptr, 16);
+      if(auto hi = getenv("ARES_BUSPROF_HI")) busProfHi = strtoul(hi, nullptr, 16);
+    }
+    u32 pc = (u32)ipu.pc;
+    busProf.cpuAudio = pc >= busProfLo && pc < busProfHi;
+    if((++busProfTicks & 0xfffff) == 0) busProfWrite();
+  }
+  if(cpuProfPath) {
+    if(!cpuProf) {
+      cpuProf = (CpuProfEntry*)calloc(0x200000, sizeof(CpuProfEntry));
+      cpuProfLines = (u32*)calloc(0x80000 * 2, sizeof(u32));
+      if(getenv("ARES_CPUPROF_LO")) cpuProfBytes = (u32*)calloc(0x800000 * 2, sizeof(u32));
+      if(auto lo = getenv("ARES_CPUPROF_LO")) cpuProfLo = strtoul(lo, nullptr, 16);
+      if(auto hi = getenv("ARES_CPUPROF_HI")) cpuProfHi = strtoul(hi, nullptr, 16);
+    }
+    u64 pc = ipu.pc; s64 clock = Thread::clock; u32 fills = cpuProfFills, writebacks = cpuProfWritebacks;
+    auto imisses = profile.icacheMisses;
+    bool result = instructionInner();
+    if((pc >> 23) == (0xffffffff80000000ull >> 23)) {
+      auto& e = cpuProf[(pc & 0x7fffff) >> 2];
+      e.instructions++; e.clocks += Thread::clock - clock;
+      e.fills += cpuProfFills - fills; e.writebacks += cpuProfWritebacks - writebacks;
+      e.ifills += profile.icacheMisses - imisses;
+    }
+    //ARES_ITRACE=<file>: what one thread executes, in order, as runs of consecutive instructions (u32 first pc,
+    //u32 count), for laying code out; ARES_ITRACE_THREAD=<hex address of __osRunningThread>:<thread id>;
+    //ARES_ITRACE_WINDOW runs recorded out of every ARES_ITRACE_PERIOD (the thread's own); (0xFFFFFFFF, 0) opens a
+    //window, (0xFFFFFFFE, n) says n runs of other threads went by
+    static const char* itracePath = getenv("ARES_ITRACE");
+    if(itracePath) {
+      static FILE* fp = fopen(itracePath, "wb");
+      static u32 runAddr = 0, wantId = 0, nextPc = 0, runPc = 0, runLen = 0, gap = 0;
+      static u64 window = 2000000, period = 64000000, count = 0;
+      static bool init = false, mine = false;
+      if(!init) {
+        init = true;
+        if(auto t = getenv("ARES_ITRACE_THREAD")) { runAddr = strtoul(t, nullptr, 16) & 0x7fffff; if(auto c = strchr(t, ':')) wantId = strtoul(c + 1, nullptr, 0); }
+        if(auto t = getenv("ARES_ITRACE_WINDOW")) window = strtoull(t, nullptr, 0);
+        if(auto t = getenv("ARES_ITRACE_PERIOD")) period = strtoull(t, nullptr, 0);
+      }
+      if(fp && (u32)pc != nextPc) {
+        if(runLen) {
+          if(!mine) gap++;
+          else {
+            u64 at = count++ % period;
+            if(at < window) {
+              if(at == 0) { u32 m[2] = {0xffffffffu, 0}; fwrite(m, 4, 2, fp); gap = 0; }
+              if(gap) { u32 m[2] = {0xfffffffeu, gap}; fwrite(m, 4, 2, fp); gap = 0; }
+              u32 m[2] = {runPc, runLen}; fwrite(m, 4, 2, fp);
+              if(at == window - 1) fflush(fp);
+            } else gap = 0;
+          }
+        }
+        runPc = (u32)pc; runLen = 0;
+        mine = (pc >> 31) == 0x1ffffffffull;
+        if(mine && runAddr) {
+          u32 th = rdram.ram.read<Word>(runAddr, RBusDevice::ARES_DEBUGGER) & 0x7fffff;
+          mine = th && rdram.ram.read<Word>(th + 0x14, RBusDevice::ARES_DEBUGGER) == wantId;
+        }
+      }
+      runLen++; nextPc = (u32)pc + 4;
+    }
+    if((++cpuProfTotal & 0x1ffffff) == 0) cpuProfWrite();
+    //ARES_CPUPROF_MARK=<hex address of a u32 in RDRAM>: each time the game changes that word, the profile so far is
+    //also saved as <file>.seg<count>.<the word's old value> (the totals up to then: a leg's cost is the difference
+    //between two)
+    static const char* markEnv = getenv("ARES_CPUPROF_MARK");
+    if(markEnv && (cpuProfTotal & 0xfff) == 0) {
+      static u32 markAddr = strtoul(markEnv, nullptr, 16) & 0x7fffff, markLast = 0, markCount = 0;
+      u32 mark = rdram.ram.read<Word>(markAddr, RBusDevice::ARES_DEBUGGER);
+      if(mark != markLast) {
+        const char* keep = cpuProfPath;
+        static char name[1024];
+        snprintf(name, sizeof(name), "%s.seg%04u.%u", keep, markCount++, markLast);
+        cpuProfPath = name; cpuProfWrite(); cpuProfPath = keep;
+        markLast = mark;
+      }
+    }
+    return result;
+  }
+  return instructionInner();
+}
