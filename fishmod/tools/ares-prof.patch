+    fprintf(fp, "sp_other_dmas %llu 0 %llu 0\nsp_audio_dmas %llu 0 %llu 0\n", (unsigned long long)busProf.dmas[0][0],
+      (unsigned long long)busProf.dmas[0][1], (unsigned long long)busProf.dmas[1][0], (unsigned long long)busProf.dmas[1][1]);
+    for(u32 out : range(2)) for(u32 im : range(2)) for(u32 a : range(512)) {
+      auto& e = busProf.audioDma[out][im][a];
+      if(e[0]) fprintf(fp, "audio_dma %s %s 0x%03x %u %u\n", out ? "out" : "in", im ? "imem" : "dmem", a << 3, e[0], e[1]);
+    }
+    fclose(fp);
+    rename(tmp, busProfPath);
+  }
+}
