+    if((pc >> 23) == (0xffffffff80000000ull >> 23)) {
+      auto& e = cpuProf[(pc & 0x7fffff) >> 2];
+      e.instructions++; e.clocks += Thread::clock - clock;
+      e.fills += cpuProfFills - fills; e.writebacks += cpuProfWritebacks - writebacks;
+      e.ifills += profile.icacheMisses - imisses;
+    }
+    if((++cpuProfTotal & 0x1ffffff) == 0) cpuProfWrite();
+    //ARES_CPUPROF_MARK=<hex address of a u32 in RDRAM>: each time the game changes that word, the profile so far is
+    //also saved as <file>.seg<count>.<the word's old value> (the totals up to then: a leg's cost is the difference
+    //between two)
+    static const char* markEnv = getenv("ARES_CPUPROF_MARK");
+    if(markEnv && (cpuProfTotal & 0xfff) == 0) {
+      static u32 markAddr = strtoul(markEnv, nullptr, 16) & 0x7fffff, markLast = 0, markCount = 0;
+      u32 mark = rdram.ram.read<Word>(markAddr, RBusDevice::ARES_DEBUGGER);
+      if(mark != markLast) {
+        const char* keep = cpuProfPath;
+        static char name[1024];
+        snprintf(name, sizeof(name), "%s.seg%04u.%u", keep, markCount++, markLast);
+        cpuProfPath = name; cpuProfWrite(); cpuProfPath = keep;
+        markLast = mark;
+      }
+    }
+    return result;
+  }
+  return instructionInner();
+}
